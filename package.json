{
  "name": "@rowanmanning/not-found",
  "version": "6.1.0",
  "type": "module",
  "description": "Create Express middleware which results in an HTTP 404 Not Found error",
  "keywords": [
    "404",
    "express",
    "middleware"
  ],
  "author": "Rowan Manning (https://rowanmanning.com/)",
  "repository": {
    "type": "git",
    "url": "https://github.com/rowanmanning/not-found.git"
  },
  "homepage": "https://github.com/rowanmanning/not-found",
  "bugs": "https://github.com/rowanmanning/not-found/issues",
  "license": "MIT",
  "engines": {
    "node": "22.x || 24.x || 26.x"
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "verify": "biome check",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --test --experimental-test-coverage --test-coverage-branches=100 --test-coverage-functions=100 --test-coverage-lines=100 test/unit/**/*.test.ts",
    "test:integration": "node --test test/integration/**/*.test.ts",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@rowanmanning/biome-config": "^3.1.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "express4": "npm:express@^4.22.3",
    "express5": "npm:express@^5.2.1",
    "husky": "^9.1.7",
    "typescript": "^7.0.2"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "files": [
    "dist",
    "index.ts"
  ]
}
